<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="pt-BR">
  <info>
    <title>Revista Brasileira de Cancerologia</title>
    <title-short>RBC</title-short>
    <id>http://www.zotero.org/styles/revista-brasileira-de-cancerologia</id>
    <link href="https://rbc.inca.gov.br/index.php/revista/instrautores" rel="documentation"/>
    <updated>2026-09-17T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="pt-BR">
    <terms>
      <term name="et-al">et al.</term>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=" "
            initialize-with=""
            delimiter=", "
            delimiter-precedes-last="always"
            et-al-min="4"
            et-al-use-first="3"/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="title">
    <text variable="title" text-case="sentence"/>
  </macro>

  <macro name="journal">
    <text variable="container-title" form="short"/>
  </macro>

  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="doi">
    <text variable="DOI" prefix="doi: "/>
  </macro>

  <macro name="access">
    <group delimiter=" ">
      <text variable="URL" prefix="Available from: "/>
      <date variable="accessed" prefix="Accessed ">
        <date-part name="day" suffix=" "/>
        <date-part name="month" form="long" suffix=" "/>
        <date-part name="year"/>
      </date>
    </group>
  </macro>

  <citation collapse="citation-number" after-collapse-delimiter=",">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout vertical-align="sup" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography second-field-align="flush" entry-spacing="0" line-spacing="1">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <group delimiter=";">
              <text macro="journal"/>
              <group delimiter="">
                <text macro="issued-year"/>
                <text variable="volume" prefix=";"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text variable="page" prefix=":"/>
              <text variable="article-number" prefix=":"/>
            </group>
            <text macro="doi"/>
          </group>
        </if>
        <else-if type="book book-section" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text variable="edition" suffix=" ed."/>
            <text variable="publisher-place"/>
            <text variable="publisher"/>
            <text macro="issued-year"/>
            <text macro="doi"/>
          </group>
        </else-if>
        <else>
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text variable="publisher-place"/>
            <text variable="publisher"/>
            <text macro="issued-year"/>
            <text macro="doi"/>
            <text macro="access"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
